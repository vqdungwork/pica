{
  "name": "analyst",
  "status": "stable",
  "description": "Elicitation, domain and industry knowledge, AS-IS and TO-BE, business rules, use cases, the domain model and the PRD. Turns a brief into something a client can agree to.",
  "owns": {
    "commands": [
      "pica-analyse.md"
    ],
    "rules": [
      "business-analysis.md",
      "domain-knowledge.md",
      "industry-knowledge.md"
    ],
    "scripts": [
      "domain-check.mjs",
      "industry-check.mjs",
      "trace-check.mjs",
      "problem-check.mjs"
    ],
    "agents": [
      "pica-analyst.md"
    ]
  },
  "requires": {
    "state": [
      "field"
    ],
    "artifacts": [
      "docs/brief.md"
    ],
    "gates": []
  },
  "produces": {
    "state": [
      "glossary",
      "businessRules",
      "useCases",
      "domainModel",
      "domainConstraints",
      "industry",
      "asIs",
      "toBe",
      "delta",
      "stakeholders",
      "exclusionsConfirmed",
      "problem",
      "trigger",
      "constraint"
    ],
    "artifacts": [
      "docs/contract.md"
    ]
  },
  "checks": [
    {
      "run": "trace-check.mjs",
      "passes": "0 findings"
    },
    {
      "run": "domain-check.mjs",
      "passes": "0 findings"
    },
    {
      "run": "industry-check.mjs",
      "passes": "0 findings"
    },
    {
      "run": "problem-check.mjs",
      "passes": "0 findings"
    }
  ],
  "definitionOfDone": [
    {
      "type": "check",
      "run": "trace-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "check",
      "run": "domain-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "check",
      "run": "industry-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "artifact",
      "path": "docs/contract.md"
    },
    {
      "type": "human",
      "says": "a non-technical reader can follow the TO-BE and say whether it is their business"
    },
    {
      "type": "gate",
      "grants": "analysisApproved"
    },
    {
      "type": "check",
      "run": "problem-check.mjs",
      "passes": "0 findings on trigger-complete"
    },
    {
      "type": "human",
      "says": "says what changed and when the window closes"
    },
    {
      "type": "gate",
      "grants": "triggerRecorded"
    },
    {
      "type": "human",
      "says": "the decider said the number out loud, and the baseline exists in a system that already runs"
    },
    {
      "type": "gate",
      "grants": "problemAgreed"
    },
    {
      "type": "human",
      "says": "names which of scope, date and resources is fixed, and who fixed it"
    },
    {
      "type": "gate",
      "grants": "constraintFixed"
    },
    {
      "type": "human",
      "says": "confirms the tiers, because the client knows which are harder than they look"
    },
    {
      "type": "gate",
      "grants": "scopeCandidate"
    },
    {
      "type": "check",
      "run": "problem-check.mjs --freeze",
      "passes": "0 findings on freeze-attributed"
    },
    {
      "type": "human",
      "says": "the decider approved the package they clicked, and change control is agreed in writing"
    },
    {
      "type": "gate",
      "grants": "scopeFrozen"
    }
  ]
}
