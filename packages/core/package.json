{
  "name": "core",
  "status": "stable",
  "description": "Intake, the contract, the state schema and every gate. Required by every other package.",
  "owns": {
    "commands": [
      "pica-close.md",
      "pica-feedback.md",
      "pica-verify.md",
      "pica.md",
      "picaflow.md"
    ],
    "rules": [
      "proposals.md",
      "reference-discipline.md",
      "review-discipline.md"
    ],
    "scripts": [
      "close-check.mjs",
      "pica-status.mjs",
      "pica-verify.mjs",
      "proposal-check.mjs"
    ],
    "hooks": [
      "dispatcher.md",
      "gate-figma-write",
      "hooks.json",
      "session-start"
    ],
    "skills": [
      "design-flow"
    ]
  },
  "requires": {
    "state": [],
    "artifacts": [],
    "gates": []
  },
  "produces": {
    "state": [
      "figmaInScope",
      "viewports",
      "delivered",
      "workPackages",
      "exclusions",
      "flows",
      "intakeApproved",
      "field",
      "scopeFrozen",
      "deadline"
    ],
    "artifacts": [
      "docs/brief.md",
      "docs/contract.md",
      "docs/exclusions.md",
      ".pica/state.json"
    ]
  },
  "checks": [
    {
      "run": "proposal-check.mjs",
      "passes": "every universal slot is presented or skipped with a reason, every option names its provenance, and every choice records who, when and their own words",
      "args": "<state> --phase design",
      "phase": "design",
      "needs": [
        "proposals"
      ]
    },
    {
      "run": "close-check.mjs",
      "passes": "0 findings",
      "args": "<state>",
      "phase": "close",
      "needs": [
        "closeout"
      ]
    },
    {
      "run": "proposal-check.mjs",
      "passes": "S6 and S7 presented, priced per use case and stated in consequences",
      "args": "<state> --phase scope",
      "phase": "scope",
      "needs": [
        "proposals"
      ]
    }
  ],
  "definitionOfDone": [
    {
      "type": "artifact",
      "path": "docs/contract.md"
    },
    {
      "type": "artifact",
      "path": "docs/exclusions.md"
    },
    {
      "type": "human",
      "says": "the human approved the contract, exclusions, options and tiers"
    },
    {
      "type": "gate",
      "grants": "intakeApproved"
    },
    {
      "type": "gate",
      "grants": "htmlApproved:<wp>"
    },
    {
      "type": "check",
      "run": "close-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "human",
      "says": "read the original brief cold and did not substitute the contract"
    },
    {
      "type": "gate",
      "grants": "delivered"
    }
  ]
}
