#!/usr/bin/env bash
# SessionStart hook for the pica plugin.
#
# Injects hooks/dispatcher.md into the session as additional context, on startup,
# clear and compact. The compact case is the one that matters: rules that live only
# in conversation decay inside a long session, and this puts them back.
#
# Injection pattern adapted from superpowers (MIT, Jesse Vincent).
# https://github.com/obra/superpowers

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DISPATCHER="${SCRIPT_DIR}/dispatcher.md"

emit() {
  # $1 = already JSON-escaped string
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$1"
}

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

if [ ! -r "$DISPATCHER" ]; then
  # Never fail silently. A silent failure is indistinguishable from a working install.
  emit "$(escape_for_json "pica: dispatcher.md could not be read at ${DISPATCHER}. The workflow rules are NOT loaded. Tell the user their pica install is broken.")"
  exit 0
fi

content="$(cat "$DISPATCHER")"
wrapped="<system-reminder>
${content}
</system-reminder>"

emit "$(escape_for_json "$wrapped")"
