{
  "name": "research",
  "status": "stable",
  "description": "Audit the sources named in the contract and derive tokens with provenance recorded per token.",
  "owns": {
    "commands": [],
    "rules": [
      "design-vocabulary.md",
      "research.md"
    ],
    "scripts": [
      "schema-check.mjs"
    ],
    "agents": [
      "pica-researcher.md"
    ]
  },
  "requires": {
    "state": [
      "audience"
    ],
    "artifacts": [
      "docs/contract.md"
    ],
    "gates": [
      "intakeApproved"
    ]
  },
  "produces": {
    "state": [
      "measured"
    ],
    "artifacts": [
      "tokens/tokens.json",
      "tokens/tokens.css"
    ]
  },
  "checks": [
    {
      "run": "schema-check.mjs",
      "passes": "0 findings",
      "args": "<state>",
      "phase": "research",
      "needs": [
        "measured"
      ]
    }
  ],
  "definitionOfDone": [
    {
      "type": "artifact",
      "path": "tokens/tokens.json"
    },
    {
      "type": "artifact",
      "path": "tokens/tokens.css"
    },
    {
      "type": "human",
      "says": "every token records its source and whether it was taken or derived"
    },
    {
      "type": "gate",
      "grants": "tokensApproved"
    }
  ]
}
