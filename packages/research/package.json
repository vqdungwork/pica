    { "type": "artifact", "path": "tokens/tokens.json" },
    { "type": "artifact", "path": "tokens/tokens.css" },
    { "type": "human", "says": "every token records its source and whether it was taken or derived" },
    { "type": "gate",  "grants": "tokensApproved" }
  ]
}
