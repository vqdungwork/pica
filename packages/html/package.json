{
  "name": "html",
  "status": "stable",
  "description": "The UI kit and work packages in HTML at every declared viewport, and the measured gate before approval.",
  "owns": {
    "commands": [
      "pica-wp.md"
    ],
    "rules": [
      "html-gates.md",
      "html-prototype.md",
      "native-mobile.md",
      "react-demo.md"
    ],
    "scripts": [
      "capture-html-reference.mjs",
      "code-tokens-check.mjs",
      "contrast-check.mjs",
      "coverage-check.mjs",
      "flow-check.mjs",
      "parity-check.mjs",
      "shell-check.mjs",
      "spacing-check.mjs",
      "verify-html.mjs",
      "concept-check.mjs",
      "structure-check.mjs",
      "direction-spread-check.mjs",
      "foundations-check.mjs",
      "state-coverage-check.mjs",
      "font-check.mjs"
    ],
    "agents": [
      "pica-designer.md"
    ]
  },
  "requires": {
    "state": [
      "viewports"
    ],
    "artifacts": [
      "tokens/tokens.css"
    ],
    "gates": [
      "intakeApproved"
    ]
  },
  "produces": {
    "state": [
      "packages.html.built"
    ],
    "artifacts": [
      "html/",
      ".audit/html-reference.json",
      ".audit/html-reference-forced.json"
    ]
  },
  "checks": [
    {
      "run": "verify-html.mjs",
      "passes": "0 findings across viewport-tagged, overflow, tall-screen-pair, viewport-coverage",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json",
        "viewports"
      ]
    },
    {
      "run": "parity-check.mjs",
      "passes": "0 findings, nominal and structural",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json"
      ]
    },
    {
      "run": "contrast-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json"
      ]
    },
    {
      "run": "spacing-check.mjs",
      "passes": "content does not touch the frame edge, every screen at one viewport sits the same distance from it, and every gap between stacked siblings is on the declared spacing scale",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json"
      ]
    },
    {
      "run": "coverage-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json",
        "useCases"
      ]
    },
    {
      "run": "flow-check.mjs",
      "passes": "0 findings, or --allow-none for a boards-only package",
      "args": "--dir html --state <state>",
      "phase": "design",
      "needs": [
        "@html",
        "flows"
      ]
    },
    {
      "run": "shell-check.mjs",
      "passes": "the shell says what it does not do, the interactive flow leads and is the default, all three zoom controls exist with fit-screen uncapped, no tab navigates away, the groups are in order, and the frame inset is on the spacing scale",
      "args": "<review> <state>",
      "phase": "design",
      "needs": [
        "@html/review.html"
      ]
    },
    {
      "run": "concept-check.mjs",
      "passes": "0 findings",
      "args": "<state>",
      "phase": "design",
      "needs": [
        "workPackages"
      ]
    },
    {
      "run": "code-tokens-check.mjs",
      "passes": "0 findings",
      "args": "<src> <tokens> <state>",
      "phase": "build",
      "needs": [
        "@src",
        "@tokens/tokens.json"
      ]
    },
    {
      "run": "structure-check.mjs",
      "passes": "0 findings",
      "args": "<structureDir> <state>",
      "phase": "design",
      "needs": [
        "@html/structure"
      ]
    },
    {
      "run": "direction-spread-check.mjs",
      "passes": "0 findings",
      "args": "<state>",
      "phase": "design",
      "needs": [
        "proposals"
      ]
    },
    {
      "run": "foundations-check.mjs",
      "passes": "0 findings",
      "args": "<designSystem> <tokens> <state>",
      "phase": "design",
      "needs": [
        "@html/design-system.html",
        "@tokens/tokens.json"
      ]
    },
    {
      "run": "state-coverage-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json",
        "stateModel"
      ]
    },
    {
      "run": "font-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "close",
      "needs": [
        "@.audit/html-reference.json",
        "direction"
      ]
    }
  ],
  "definitionOfDone": [
    {
      "type": "check",
      "run": "verify-html.mjs",
      "passes": "0 findings"
    },
    {
      "type": "check",
      "run": "parity-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "check",
      "run": "flow-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "human",
      "says": "every frame rendered and looked at, per viewport, after the last change"
    },
    {
      "type": "human",
      "says": "the main flow clicked end to end"
    },
    {
      "type": "human",
      "says": "the client approved this package's HTML; core records htmlApproved:<wp>. This package requests that gate and does not grant it"
    },
    {
      "type": "check",
      "run": "concept-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "human",
      "says": "two or more concepts were compared on every complex package, and each named what it serves badly"
    },
    {
      "type": "gate",
      "grants": "conceptsDiverged"
    }
  ]
}
