{
  "name": "developer",
  "status": "stable",
  "description": "Build the approved design into working code: the API contract as a seam, state placement, error shape, accessibility in code, and the sector's conventions.",
  "owns": {
    "commands": [
      "pica-develop.md"
    ],
    "rules": [
      "engineering.md"
    ],
    "scripts": [
      "dev-check.mjs"
    ],
    "agents": [
      "pica-developer.md"
    ]
  },
  "requires": {
    "state": [
      "apiContract",
      "stateStrategy",
      "stack"
    ],
    "artifacts": [
      "tokens/tokens.json"
    ],
    "gates": []
  },
  "produces": {
    "state": [
      "perfBudget"
    ],
    "artifacts": []
  },
  "checks": [
    {
      "run": "dev-check.mjs",
      "passes": "0 findings",
      "args": "<src> <state>",
      "phase": "build",
      "needs": [
        "@src"
      ]
    }
  ],
  "definitionOfDone": [
    {
      "type": "check",
      "run": "dev-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "human",
      "says": "a person used the build rather than reading it, and every screen in the matrix exists in every state"
    },
    {
      "type": "gate",
      "grants": "built"
    }
  ]
}
