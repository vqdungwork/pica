{
  "name": "figma",
  "status": "stable",
  "description": "Port an approved package to Figma, or rebuild an existing Figma file, and verify it by measurement.",
  "owns": {
    "commands": [
      "pica-port.md",
      "pica-prototype.md",
      "pica-review.md"
    ],
    "rules": [
      "figma-screens.md",
      "figma-elements.md",
      "figma-mcp.md",
      "figma-gates.md",
      "figma-rebuild.md"
    ],
    "scripts": [
      "geometry-diff.mjs",
      "figma-audit.js",
      "capture-baseline.js",
      "source-parity.js"
    ]
  },
  "requires": {
    "state": [
      "viewports",
      "figmaInScope=true"
    ],
    "artifacts": [
      ".audit/html-reference.json",
      ".audit/html-reference-forced.json"
    ],
    "gates": [
      "htmlApproved:<wp>"
    ]
  },
  "produces": {
    "state": [
      "packages.figma.ported",
      "packages.figma.annotated"
    ],
    "artifacts": [
      ".audit/figma-dump.json"
    ]
  },
  "checks": [
    {
      "run": "geometry-diff.mjs",
      "passes": "0 findings above tolerance AND more than 0 text runs compared"
    },
    {
      "run": "figma-audit.js",
      "passes": "every count returns 0"
    },
    {
      "run": "source-parity.js",
      "passes": "contamination 0, 0 missing and 0 extra strings per screen except registered deviations, and more than 0 screens compared",
      "when": "rebuild of an existing Figma file, in place of geometry-diff.mjs"
    }
  ],
  "definitionOfDone": [
    {
      "type": "check",
      "run": "geometry-diff.mjs",
      "passes": "0 findings"
    },
    {
      "type": "check",
      "run": "figma-audit.js",
      "passes": "0 findings"
    },
    {
      "type": "check",
      "run": "source-parity.js",
      "passes": "0 findings",
      "when": "rebuild"
    },
    {
      "type": "human",
      "says": "every frame rendered and looked at, after the last change"
    },
    {
      "type": "gate",
      "grants": "figmaVerified:<wp>"
    }
  ]
}
