{
  "name": "ux-engineer",
  "status": "stable",
  "description": "pica UX engineer: the interactive demo in code — tokens as structured data, the component library, every screen at every viewport in every state, measured before anyone sees it.",
  "owns": {
    "commands": [
      "pica-wp.md"
    ],
    "rules": [
      "html-gates.md",
      "html-prototype.md",
      "native-mobile.md",
      "react-demo.md"
    ],
    "scripts": [
      "a11y-check.mjs",
      "capture-html-reference.mjs",
      "code-tokens-check.mjs",
      "concept-check.mjs",
      "contrast-check.mjs",
      "coverage-check.mjs",
      "flow-check.mjs",
      "foundations-check.mjs",
      "parity-check.mjs",
      "screen-states-check.mjs",
      "shell-check.mjs",
      "spacing-check.mjs",
      "state-coverage-check.mjs",
      "verify-html.mjs",
      "visual-qa-check.mjs",
      "url-param-guard.mjs",
      "layout-coherence-check.mjs",
      "keyboard-check.mjs",
      "axe-check.mjs",
      "visual-baseline-check.mjs",
      "screenreader-check.mjs",
      "canvas-plan.mjs",
      "build-check.mjs",
      "artifact-readiness-check.mjs",
      "target-size-check.mjs",
      "flow-walk-check.mjs"
    ],
    "agents": [
      "pica-ux-engineer.md"
    ],
    "skills": [
      "generating-mock-data",
      "reviewing-your-own-work",
      "scaffolding-the-demo",
      "handing-over-as-an-artifact"
    ]
  },
  "requires": {
    "state": [
      "viewports",
      "direction",
      "copyRules",
      "architecture"
    ],
    "artifacts": [
      "tokens/tokens.css"
    ],
    "gates": [
      "intakeApproved"
    ]
  },
  "produces": {
    "state": [
      "packages.html.built",
      "demo"
    ],
    "artifacts": [
      "html/",
      ".audit/html-reference.json",
      ".audit/html-reference-forced.json",
      "canvas.json"
    ]
  },
  "checks": [
    {
      "run": "a11y-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json"
      ]
    },
    {
      "run": "code-tokens-check.mjs",
      "passes": "0 findings",
      "args": "<src> <tokens> <state>",
      "phase": "build",
      "needs": [
        "@src",
        "@tokens/tokens.json"
      ]
    },
    {
      "run": "concept-check.mjs",
      "passes": "0 findings",
      "args": "<state>",
      "phase": "design",
      "needs": [
        "workPackages"
      ]
    },
    {
      "run": "contrast-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json"
      ]
    },
    {
      "run": "coverage-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json",
        "useCases"
      ]
    },
    {
      "run": "flow-check.mjs",
      "passes": "0 findings, or --allow-none for a boards-only package",
      "args": "--dir html --state <state>",
      "phase": "design",
      "needs": [
        "@html",
        "flows"
      ]
    },
    {
      "run": "foundations-check.mjs",
      "passes": "0 findings",
      "args": "<designSystem> <tokens> <state>",
      "phase": "design",
      "needs": [
        "@html/design-system.html",
        "@tokens/tokens.json"
      ]
    },
    {
      "run": "parity-check.mjs",
      "passes": "0 findings, nominal and structural",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json"
      ]
    },
    {
      "run": "shell-check.mjs",
      "passes": "the shell says what it does not do, the interactive flow leads and is the default, all three zoom controls exist with fit-screen uncapped, no tab navigates away, the groups are in order, and the frame inset is on the spacing scale",
      "args": "<review> <state>",
      "phase": "design",
      "needs": [
        "@html/review.html"
      ]
    },
    {
      "run": "spacing-check.mjs",
      "passes": "content does not touch the frame edge, every screen at one viewport sits the same distance from it, and every gap between stacked siblings is on the declared spacing scale",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json"
      ]
    },
    {
      "run": "state-coverage-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json",
        "stateModel"
      ]
    },
    {
      "run": "verify-html.mjs",
      "passes": "0 findings across viewport-tagged, overflow, tall-screen-pair, viewport-coverage",
      "args": "<ref> <state>",
      "phase": "design",
      "needs": [
        "@.audit/html-reference.json",
        "viewports"
      ]
    },
    {
      "run": "screen-states-check.mjs",
      "passes": "0 findings",
      "args": "<state>",
      "phase": "design",
      "needs": [
        "@html"
      ]
    },
    {
      "run": "url-param-guard.mjs",
      "passes": "0 findings",
      "args": "--url <servedDemo> --valid <knownRoute>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "layout-coherence-check.mjs",
      "passes": "0 findings",
      "args": "--url <servedDemo> --routes <everyScreenAndState>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "keyboard-check.mjs",
      "passes": "0 findings",
      "args": "--url <servedDemo> --routes <everyScreenAndState> --open <opener> --modal <dialog>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "axe-check.mjs",
      "passes": "0 violations",
      "args": "--url <servedDemo> --routes <everyScreenAndState> --include <frame>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "visual-baseline-check.mjs",
      "passes": "0 changed",
      "args": "--url <servedDemo> --routes <everyScreenAndState> --dir <baselines>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "screenreader-check.mjs",
      "passes": "0 findings",
      "args": "--url <servedDemo> --routes <everyScreenAndState> --act <primary> --modal <dialog>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "build-check.mjs",
      "passes": "0 findings",
      "args": "--cmd <buildCmd> --cwd <buildCwd> --out <buildOut>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "artifact-readiness-check.mjs",
      "passes": "0 findings",
      "args": "--dir <buildOut>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "target-size-check.mjs",
      "passes": "0 findings",
      "args": "--url <servedDemo> --routes <everyScreenAndState> --min <targetFloor> --ignore <harnessChrome>",
      "phase": "design",
      "needs": []
    },
    {
      "run": "flow-walk-check.mjs",
      "passes": "0 findings: every control, clicked up to three deep from every route, leaves something on screen and throws nothing",
      "args": "--url <servedDemo> --routes <everyScreenAndState> --frame <frame> --ignore <harnessChrome>",
      "phase": "design",
      "needs": []
    }
  ],
  "definitionOfDone": [
    {
      "type": "check",
      "run": "verify-html.mjs",
      "passes": "0 findings"
    },
    {
      "type": "check",
      "run": "parity-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "check",
      "run": "flow-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "human",
      "says": "every frame rendered and looked at, per viewport, after the last change"
    },
    {
      "type": "human",
      "says": "the main flow clicked end to end"
    },
    {
      "type": "human",
      "says": "the client approved this package's HTML; core records htmlApproved:<wp>. This package requests that gate and does not grant it"
    },
    {
      "type": "check",
      "run": "concept-check.mjs",
      "passes": "0 findings"
    },
    {
      "type": "human",
      "says": "two or more concepts were compared on every complex package, and each named what it serves badly"
    },
    {
      "type": "gate",
      "grants": "conceptsDiverged"
    }
  ]
}
