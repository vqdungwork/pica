      "needs": [
        "proposals"
      ]
    },
    {
      "run": "font-check.mjs",
      "passes": "0 findings",
      "args": "<ref> <state>",
      "phase": "close",
      "needs": [
        "@.audit/html-reference.json",
        "direction"
      ]
    },
    {
      "run": "palette-check.mjs",
      "passes": "every direction carries a palette of named roles, declares which foreground sits on which background, every declared pair meets its floor (4.5 body, 3 large, 3 interface), and no hue the sector reserves is spent decoratively",
      "args": "<state>",
      "phase": "design",
      "needs": [
        "proposals"
      ]
    }
  ],
  "definitionOfDone": []
}
