{
  "name": "ui-designer",
  "status": "stable",
  "description": "pica UI designer: the visual direction argued against the sector's settled tradition, the palette proved against contrast before it is offered, and the style tiles the client chooses from.",
  "owns": {
    "commands": [],
    "rules": [
      "craft.md",
      "direction.md"
    ],
    "scripts": [
      "direction-spread-check.mjs",
      "font-check.mjs",
      "palette-check.mjs"
    ],
    "agents": [
      "pica-ui-designer.md"
    ],
    "skills": [
      "building-a-style-tile",
      "deriving-tokens"
    ]
  },
  "requires": {
    "state": [
      "field",
      "proposals",
      "measured"
    ],
    "artifacts": [],
    "gates": []
  },
  "produces": {
    "state": [
      "direction"
    ],
    "artifacts": []
  },
  "checks": [
    {
      "run": "direction-spread-check.mjs",
      "passes": "0 findings",
      "args": "<state>",
