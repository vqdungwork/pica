{
  "serve": {
    "cmd": "node scripts/serve.mjs 4173",
    "cwd": ".",
    "url": "http://127.0.0.1:4173/app-approvals.html"
  },
  "build": {
    "cmd": "node scripts/build.mjs",
    "cwd": ".",
    "out": "dist"
  },
  "substitutions": {
    "<everyScreenAndState>": "scr=queue,scr=queue&state=held,scr=queue&state=empty,scr=payment,scr=audit",
    "<knownRoute>": "scr=payment",
    "<targetFloor>": "44",
    "<harnessChrome>": null,
    "<frame>": ".frame",
    "<primary>": "[data-go]",
    "<opener>": null,
    "<dialog>": null,
    "<baselines>": ".audit/baseline",
    "<srcDir>": "html"
  }
}
